# Copy to .env.local and fill in.

# Local development against the Firebase Emulator Suite
# (start it with ./start.sh in the Motirong-firebase repo).
NEXT_PUBLIC_USE_EMULATORS=true
NEXT_PUBLIC_EMULATOR_HOST=127.0.0.1

# Self-hosted backend, when the callables are served off Cloud Functions
# (see functions/src/server.ts in motiroong-backend). Leave blank to call
# deployed Cloud Functions instead. Ignored while USE_EMULATORS is true.
NEXT_PUBLIC_BACKEND_URL=

# The deployed project. Needed only when NEXT_PUBLIC_USE_EMULATORS is not
# true: register a Web app in the Firebase console (Project settings → Your
# apps) and copy its config values here.
NEXT_PUBLIC_FIREBASE_PROJECT_ID=motirong-32a1c
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=motirong-32a1c.firebaseapp.com
NEXT_PUBLIC_FIREBASE_APP_ID=
